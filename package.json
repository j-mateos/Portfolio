{
    "name": "portfolio",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "bun vite .",
        "format": "bun prettier . --write --log-level warn",
        "format-check": "bun prettier . --check --log-level warn",
        "lint": "bun eslint . --fix",
        "lint-check": "bun eslint .",
        "fix": "bun run format && bun run lint",
        "fix-check": "bun run format-check && bun run lint-check",
        "test": "bun vitest .",
        "build": "bun vite build .",
        "preview": "bun run build && bun vite preview .",
        "deps-check": "bunx knip && bun outdated",
        "deps-update": "bunx npm-check-updates -u && bun update --latest && bun install",
        "deps-audit": "bun audit",
        "clean-build": "rm -rf dist",
        "clean-deps": "rm -rf node_modules bun.lock"
    },
    "dependencies": {
        "@eslint/js": "10.0.1",
        "@vercel/analytics": "2.0.1",
        "i18next": "26.5.4",
        "i18next-http-backend": "4.0.4",
        "prettier": "3.9.10",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-i18next": "17.1.0"
    },
    "devDependencies": {
        "@eslint/compat": "2.1.1",
        "@eslint/eslintrc": "3.3.7",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "@vitest/ui": "5.0.5",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.7",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "happy-dom": "21.0.4",
        "tailwindcss": "4.3.3",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
